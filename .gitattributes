# Keep the upstream provider notice unchanged, including its original whitespace.
licenses/FFmpeg/PROVIDER-README.txt -whitespace
licenses/FFmpeg/dependencies/* -text -whitespace
licenses/FFmpeg/BUILD_CONFIG.txt -text -whitespace
dev/release-source/* text eol=lf
dev/release-source/ARTIFACT.json -text -whitespace
dev/reports/archive/gpl-source-2026-10-03/* -text -whitespace
licenses/FFmpeg/dependencies/avisynth-LICENSE.rst conflict-marker-size=32
# Bash/Python recipes must retain LF in Windows Git checkouts.
dev/ffmpeg-build/scripts/* text eol=lf
dev/ffmpeg-build/manifests/* text eol=lf
# Preserve captured evidence and installed upstream runtime license bytes.
licenses/FFmpeg/toolchain/* -text -whitespace
dev/reports/archive/controlled-ffmpeg-2026-10-04/* -text -whitespace
# 雜湊測試比對位元組，固定換行方式，乾淨 clone 在任何 autocrlf 設定下都要能通過。
app/** -text
electron/** -text
dev/notes/** -text
dev/tests/** -text
dev/fixtures/** -text
License.txt text eol=crlf
dev/tests/fixtures/baselines/inspector-protected-hashes.json text eol=crlf
dev/tests/fixtures/baselines/srt-protected-hashes.json text eol=crlf
dev/tests/fixtures/baselines/template-protected-hashes.json text eol=crlf
