{
  "name": "wavecanvas",
  "productName": "WaveCanvas",
  "version": "1.0.0",
  "description": "WaveCanvas local audio visualizer and project editor for Windows",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "electron:dev": "node dev/tools/electron-run.cjs dev",
    "electron:start": "node dev/tools/electron-run.cjs start",
    "electron:build": "node dev/tools/electron-run.cjs build",
    "postelectron:build": "node dev/tools/audit-electron-build.cjs",
    "electron:test": "node dev/tools/electron-smoke.cjs",
    "electron:test:build": "node dev/tools/electron-smoke.cjs --packaged",
    "project:test": "node dev/tools/project-smoke.cjs",
    "project:test:build": "node dev/tools/project-smoke.cjs --packaged",
    "test": "node --test dev/tests/*.test.cjs",
    "browser:start": "node dev/tools/serve.cjs",
    "export:test": "node dev/tools/export-qa.cjs",
    "export:test:real": "node dev/tools/export-smoke.cjs --full",
    "export:test:build": "node dev/tools/export-smoke.cjs --packaged",
    "preferences:test": "node dev/tools/preferences-smoke.cjs",
    "preferences:test:build": "node dev/tools/preferences-smoke.cjs --packaged",
    "browser:test": "node dev/tools/browser-smoke.cjs",
    "build:audit": "node dev/tools/audit-electron-build.cjs",
    "repo:size": "node dev/tools/audit-repo-size.cjs",
    "options:test": "node dev/tools/options-smoke.cjs",
    "options:test:build": "node dev/tools/options-smoke.cjs --packaged",
    "fonts:test": "node dev/tools/fonts-smoke.cjs",
    "fonts:test:build": "node dev/tools/fonts-smoke.cjs --packaged",
    "release:build": "node dev/tools/electron-run.cjs release",
    "release:check": "node dev/tools/release-check.cjs",
    "postrelease:build": "node dev/tools/release-check.cjs --generate"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.wavecanvas.desktop",
    "productName": "WaveCanvas",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "afterPack": "dev/tools/after-electron-pack.cjs",
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json",
      "License.txt",
      "README.md"
    ],
    "win": {
      "target": "dir",
      "icon": "app/assets/wavecanvas.ico",
      "executableName": "WaveCanvas"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe",
          "LICENSE",
          "README.txt",
          "BUILD.json"
        ]
      },
      {
        "from": "licenses",
        "to": "licenses",
        "filter": [
          "FFmpeg/BUILD_CONFIG.txt",
          "FFmpeg/BUILD_INFO.json",
          "FFmpeg/DEPENDENCIES.json",
          "FFmpeg/LICENSE",
          "FFmpeg/PROVIDER-README.txt",
          "FFmpeg/SHA256.txt",
          "FFmpeg/SOURCE_INFO.txt",
          "FFmpeg/SOURCE_MANIFEST.json",
          "FFmpeg/VERSION.txt",
          "FFmpeg/dependencies/ffmpeg-COPYING.GPLv2",
          "FFmpeg/dependencies/ffmpeg-COPYING.GPLv3",
          "FFmpeg/dependencies/ffmpeg-COPYING.LGPLv2.1",
          "FFmpeg/dependencies/ffmpeg-COPYING.LGPLv3",
          "FFmpeg/dependencies/ffmpeg-LICENSE.md",
          "FFmpeg/dependencies/x264-COPYING",
          "FFmpeg/dependencies/zlib-LICENSE",
          "FFmpeg/toolchain/crt-COPYING",
          "FFmpeg/toolchain/crt-COPYING.MinGW-w64-runtime.txt",
          "FFmpeg/toolchain/crt-COPYING.MinGW-w64.txt",
          "FFmpeg/toolchain/headers-COPYING",
          "FFmpeg/toolchain/headers-COPYING.MinGW-w64-runtime.txt",
          "FFmpeg/toolchain/headers-COPYING.MinGW-w64.txt",
          "FFmpeg/toolchain/headers-ddk-readme.txt",
          "FFmpeg/toolchain/libatomic-COPYING.RUNTIME",
          "FFmpeg/toolchain/libatomic-COPYING3",
          "FFmpeg/toolchain/libgcc-COPYING.RUNTIME",
          "FFmpeg/toolchain/libgcc-COPYING3",
          "FFmpeg/toolchain/winpthreads-COPYING",
          "THIRD_PARTY_NOTICES.md",
          "WaveCanvas-LICENSE.txt"
        ]
      }
    ],
    "copyright": "WaveCanvas contributors; original attribution in License.txt",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "WaveCanvas",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "WaveCanvas-Setup-${version}.${ext}",
      "include": "dev/installer.nsh",
      "packElevateHelper": false,
      "license": "License.txt",
      "installerLanguages": [
        "en_US",
        "zh_TW"
      ],
      "displayLanguageSelector": true,
      "unicode": true
    },
    "fileAssociations": [
      {
        "ext": "waveproj",
        "name": "WaveCanvas.Project",
        "description": "WaveCanvas Project",
        "role": "Editor"
      }
    ]
  },
  "author": "WaveCanvas contributors"
}
